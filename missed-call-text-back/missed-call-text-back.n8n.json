      "parameters": {
        "jsCode": "const CFG={business:'Desert Flow Plumbing',bizPhone:'(520) 555-0142',bookingLink:'https://example.com/book',ownerPhone:'+15205550199',blocklist:['+15205550111']};\nconst b=$input.first().json.body||{};const status=(b.CallStatus||b.DialCallStatus||'').toLowerCase();\nconst from=b.From||'';const sd=$getWorkflowStaticData('global');sd.leads=sd.leads||{};sd.suppressed=sd.suppressed||{};\nconst missed=['no-answer','busy','failed','canceled'].includes(status)||b.voicemail==='true';\nlet skip=null;\nif(!missed)skip='answered';else if(!from)skip='no caller id';else if(sd.suppressed[from])skip='opted out';else if(CFG.blocklist.includes(from))skip='blocklist';\nelse if(sd.leads[from]&&sd.leads[from].state==='open'&&Date.now()-sd.leads[from].ts<24*3600e3)skip='open thread <24h';\nif(!skip)sd.leads[from]={state:'open',ts:Date.now(),sent:0};\nreturn [{json:{from,status,skip,proceed:!skip,...CFG,callTime:new Date().toISOString()}}];"
      },
