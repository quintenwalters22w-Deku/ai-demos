    {
      "parameters": {
        "jsCode": "const CFG={business:'Desert Flow Plumbing',bizPhone:'(520) 555-0142',bookingLink:'https://example.com/book',ownerPhone:'+15205550199',blocklist:['+15205550111']};\nconst b=$input.first().json.body||{};const from=b.From||'';const text=(b.Body||'').trim();const kw=text.toUpperCase();\nconst sd=$getWorkflowStaticData('global');sd.leads=sd.leads||{};sd.suppressed=sd.suppressed||{};\nlet kind='reply',reply=null;\nif(['STOP','STOPALL','UNSUBSCRIBE','CANCEL','END','QUIT'].includes(kw)){kind='stop';sd.suppressed[from]=Date.now();reply=`You're unsubscribed from ${CFG.business}. No more messages.`;}\nelse if(kw==='START'||kw==='UNSTOP'){kind='start';delete sd.suppressed[from];reply=`You're re-subscribed to ${CFG.business}. Reply STOP to opt out.`;}\nelse if(kw==='HELP'){kind='help';reply=`${CFG.business}: call ${CFG.bizPhone}. Reply STOP to opt out.`;}\nelse if(/no heat|no ac|not cooling|leak|flood|burst|gas|sewage|emergency/i.test(text)){kind='emergency';reply=\"We're on it, a tech will call you shortly.\";}\nif(sd.leads[from]&&kind!=='help')sd.leads[from].state=kind==='stop'?'opted-out':'replied'; // any reply stops sequence\nreturn [{json:{from,text,kind,reply,urgent:kind==='emergency',...CFG}}];"
      },
