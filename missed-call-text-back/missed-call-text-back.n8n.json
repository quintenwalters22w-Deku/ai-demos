      "parameters": {
        "jsCode": "function nextAllowed(d,startH,endH){ // Arizona = UTC-7, no DST\n const az=new Date(d.getTime()-7*3600e3);const h=az.getUTCHours();\n if(h>=startH&&h<endH)return d;\n const t=new Date(az);if(h>=endH)t.setUTCDate(t.getUTCDate()+1);t.setUTCHours(startH,0,0,0);return new Date(t.getTime()+7*3600e3);}\nconst j=$('Filter Missed + Dedupe').first().json;const sd=$getWorkflowStaticData('global');sd.leads[j.from].sent=1;\nconst at=nextAllowed(new Date(Date.now()+2*3600e3),8,20);return [{json:{...j,resumeAt:at.toISOString()}}];"
