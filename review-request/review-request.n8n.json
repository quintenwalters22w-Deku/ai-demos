    {
      "parameters": {
        "jsCode": "const CFG={business:'Desert Flow Plumbing',reviewLink:'https://g.page/r/REPLACE_REVIEW_ID/review',ownerPhone:'+15205550199'};\nconst b=$input.first().json.body||{};const from=b.From||'';const text=(b.Body||'').trim();const kw=text.toUpperCase();\nconst sd=$getWorkflowStaticData('global');sd.req=sd.req||{};sd.suppressed=sd.suppressed||{};let kind='reply',reply=null;\nif(['STOP','STOPALL','UNSUBSCRIBE','CANCEL','END','QUIT'].includes(kw)){kind='stop';sd.suppressed[from]=Date.now();reply=`You're unsubscribed from ${CFG.business}. No more messages.`;}\nelse if(kw==='START'){kind='start';delete sd.suppressed[from];reply=`You're re-subscribed to ${CFG.business}. Reply STOP to opt out.`;}\nelse if(kw==='HELP'){kind='help';reply=`${CFG.business} review requests. Reply STOP to opt out.`;}\nelse if(/bad|terrible|awful|unhappy|disappoint|rude|late|never|still (leak|broken)|not (fixed|happy|working)|refund|worst|overcharg/i.test(text))kind='unhappy';\nif(sd.req[from]&&kind!=='help'&&kind!=='start')sd.req[from].state=kind; // any reply pauses the sequence; never re-ask\n// NO REVIEW GATING: the review link is never withheld or changed based on sentiment.\nreturn [{json:{from,text,kind,reply,...CFG}}];"
      },
      "id": "98dd83f1-082e-4de2-ac79-e5e803d6f577",
