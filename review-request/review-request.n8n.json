        0
      ],
      "webhookId": "5822d289-0c9c-48d6-aace-ec45a112d2c5"
    },
    {
      "parameters": {
        "jsCode": "const CFG={business:'Desert Flow Plumbing',reviewLink:'https://g.page/r/REPLACE_REVIEW_ID/review',ownerPhone:'+15205550199'};function nextAllowed(d,startH,endH){ // Arizona = UTC-7, no DST\n const az=new Date(d.getTime()-7*3600e3);const h=az.getUTCHours();\n if(h>=startH&&h<endH)return d;\n const t=new Date(az);if(h>=endH)t.setUTCDate(t.getUTCDate()+1);t.setUTCHours(startH,0,0,0);return new Date(t.getTime()+7*3600e3);}\nconst b=$input.first().json.body||{};const phone=(b.phone||'').replace(/[^\\d+]/g,'');const sd=$getWorkflowStaticData('global');sd.asked=sd.asked||{};sd.suppressed=sd.suppressed||{};sd.req=sd.req||{};\nlet skip=null;if(!phone)skip='no mobile';else if(sd.suppressed[phone])skip='opted out';else if(b.flagged)skip='job flagged (complaint/warranty)';\nelse if(sd.asked[phone]&&Date.now()-sd.asked[phone]<180*864e5)skip='asked within 180 days';\nconst sendAt=nextAllowed(new Date(Date.now()+90*60e3),9,19); // +1.5h, 9AM-7PM AZ window (else next morning)\nif(!skip){sd.asked[phone]=Date.now();sd.req[phone]={state:'queued'};}\nreturn [{json:{phone,first:b.first_name||'there',tech:b.tech||'our team',jobId:b.job_id,skip,proceed:!skip,sendAt:sendAt.toISOString(),...CFG}}];"
      },
